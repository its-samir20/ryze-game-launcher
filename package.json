{
  "name": "ryze-game-launcher",
  "productName": "RYZE Game Launcher",
  "version": "0.3.0",
  "description": "RYZE Game Launcher - a game launcher for quest tracking with a fake game window for rich presence.",
  "main": "src/main.js",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:dummy": "dotnet build src/DummyGame -c Release",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.ryze.gamelauncher",
    "productName": "RYZE Game Launcher",
    "files": [
      "src/**/*",
      "resources/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/dummygame",
        "to": "dummygame"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "RYZE-Game-Launcher.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RYZE Game Launcher",
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": true,
      "include": "build/installer.nsh",
      "artifactName": "RYZE-Game-Launcher-Setup-${version}.exe"
    },
    "extraFiles": [
      {
        "from": "build/vc_redist.x64.exe",
        "to": "vc_redist.x64.exe"
      }
    ],
    "publish": {
      "provider": "generic",
      "url": "https://github.com/its-samir20/ryze-game-launcher/releases/latest/download"
    }
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
